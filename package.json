{
  "name": "next-store-test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "postinstall": "prisma skills sync || exit 0",
    "prepare": "husky",
    "db:seed:admin": "tsx prisma/seed-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "better-auth": "^1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "input-otp": "^1.5.0",
    "jose": "^6.2.13",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "otplib": "^12.0.1",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/argon2": "^0.14.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
